{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": [],
      "inputs": ["src/**/*.ts"]
    },
    "test": {
      "dependsOn": ["typecheck"],
      "inputs": ["src/**/*.ts", "src/**/*.test.ts"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts"],
      "outputs": ["dist/**"]
    }
  }
}