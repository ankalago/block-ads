{
  "name": "block-ads",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension ad blocker — Manifest V3, declarativeNetRequest, scriptlet injection",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "biome check --write .",
    "check:ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "lefthook": "^1.11.5",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.5.1"
}
